# Copiar a .env y completar. El archivo .env NO se versiona.

TZ=America/Argentina/Buenos_Aires
APP_DEBUG=false

# Conexión de la aplicación
DB_HOST=database
DB_PORT=3306
DB_DATABASE=taller_mecanico
DB_USERNAME=taller
DB_PASSWORD=cambiar_esta_clave

# Solo para el contenedor de MySQL
MYSQL_ROOT_PASSWORD=cambiar_esta_clave_root

# off | debug | develop,debug
XDEBUG_MODE=off
