# Copiar a .env y completar. El archivo .env NO se versiona.

TZ=America/Argentina/Buenos_Aires
APP_DEBUG=false
# Dirección pública del sistema (se usa en los links de los emails)
APP_URL=http://localhost:8050

# Conexión de la aplicación
DB_HOST=database
DB_PORT=3306
DB_DATABASE=taller_mecanico
DB_USERNAME=taller
DB_PASSWORD=cambiar_esta_clave

# Solo para el contenedor de MySQL
MYSQL_ROOT_PASSWORD=cambiar_esta_clave_root

# Envío de emails (recordatorios de turnos). Vacío = deshabilitado.
# Ej. Gmail: smtp://usuario%40gmail.com:CLAVE_DE_APLICACION@smtp.gmail.com:587
MAIL_DSN=
MAIL_FROM=

# Puertos publicados en el host
APP_PORT=8050
PMA_PORT=8051
DB_HOST_PORT=3309

# Registro del sistema: debug | info | warning | error (por defecto info) y días a conservar
LOG_LEVEL=info
LOG_DIAS=30

# off | debug | develop,debug
XDEBUG_MODE=off
