{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Listen for Xdebug",
      "type": "php",
      "request": "launch",
      "port": 9004,
      "pathMappings": {
        "/var/www/html": "${workspaceFolder}/public"
      },
      "xdebugSettings": {
        "max_children": 256,
        "max_data": 1024,
        "max_depth": 3
      },
      "log": true
    }
  ]
}
