# Entorno
.env

# Dependencias
/vendor/

# Datos generados en ejecución
/storage/config/*
/storage/logs/*
/storage/uploads/
/storage/backups/
!/storage/**/.gitkeep

# Herramientas
.vscode/*
!.vscode/launch.json
.phpunit.cache/
.idea/
/backups/

# Notas locales (pendientes con datos sensibles del servidor)
*.local.md

# Ajustes propios de cada servidor (montajes extra, otros sitios en el contenedor)
docker-compose.override.yml
